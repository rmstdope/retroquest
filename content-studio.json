{
  "$schema": "https://raw.githubusercontent.com/rmstdope/content-studio/main/schema/content-studio.schema.json",
  "version": 2,
  "name": "RetroQuest",
  "description": "A retro-style text adventure played in the browser. A warm storyteller narrates; the characters are the people Elior meets on his journey.",
  "env": ".env",
  "partLabel": "Act",
  "parts": [
    {
      "id": "act1",
      "title": "Act I: The Call to Adventure"
    },
    {
      "id": "act2",
      "title": "Act II: The Gathering Storm"
    },
    {
      "id": "act3",
      "title": "Act III: Trials and Revelations"
    },
    {
      "id": "act4",
      "title": "Act IV: The Final Confrontation"
    }
  ],
  "refresh": {
    "part": "p={part}; cd web && npx -y tsx@4.23.15 --tsconfig tsconfig.json ../tts/extract-act.ts ${p#act}",
    "shared": "cd web && npx -y tsx@4.23.15 --tsconfig tsconfig.json ../tts/extract-shared.ts && npx -y tsx@4.23.15 --tsconfig tsconfig.json ../tts/extract-effects.ts"
  },
  "narration": {
    "from": {
      "part": "tts/{part}/script.json"
    },
    "models": {
      "fish": {
        "audition": "s2.1-pro-free",
        "draft": "s2.1-pro-free",
        "final": "drama-3"
      }
    },
    "output": {
      "codec": "mp3",
      "bitrate": "64k",
      "channels": 1,
      "lufs": -16
    },
    "generate": {
      "soundAlike": {
        "en": [
          ["all right", "alright"],
          ["deer", "dear"],
          ["guard", "god"]
        ]
      }
    },
    "clips": "web/public/audio/narration/{part}",
    "manifest": "web/public/audio/narration/{part}/manifest.json"
  },
  "music": {
    "from": {
      "part": "tts/{part}/music.json",
      "shared": "tts/stingers.json"
    },
    "model": "careful",
    "clips": "web/public/audio/music/generated",
    "manifest": "web/public/audio/music/generated/manifest.json"
  },
  "images": {
    "from": {
      "part": "tts/{part}/images.json"
    },
    "clips": "web/public/images/generated",
    "manifest": "web/public/images/generated/manifest.json"
  },
  "effects": {
    "from": {
      "shared": "tts/effects.json"
    },
    "model": "open-1",
    "clips": "web/public/audio/soundeffects/generated",
    "manifest": "web/public/audio/soundeffects/generated/manifest.json"
  },
  "scenes": {
    "from": {
      "part": "tts/{part}/scenes.json"
    },
    "output": {
      "lufs": -20,
      "tolerance": 2
    },
    "mix": "web/src/lantern/scenes/{part}.mix.json"
  }
}
