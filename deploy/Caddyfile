{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	header Cache-Control "no-cache"

	handle /healthz {
		respond "ok" 200
	}

	handle /release.json {
		file_server
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@file path_regexp \.[^/]+$
	handle @file {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
